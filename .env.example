# Copy this file to .env and set real values.
# Jira integration toggle
JIRA_ENABLED=false

# Jira project settings
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_PROJECT_KEY=IMON
JIRA_ISSUE_TYPE=Task
JIRA_STATUS_TRANSITION_ID=
JIRA_SUMMARY_PREFIX=Installomator label failed

# Jira credentials
JIRA_USER_EMAIL=service-account@yourcompany.com
JIRA_API_TOKEN=replace-with-your-api-token
